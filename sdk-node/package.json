{
  "name": "orphograph",
  "version": "0.1.0",
  "description": "Bitcoin-anchored folder receipts a relying party can verify without the issuer. Anchor via the Orphograph service; verify inclusion offline; file contents never leave the machine.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "orphograph": "./dist/cli.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "pretest": "tsc",
    "test": "npm run build && node --experimental-strip-types --test test/*.test.ts",
    "release:check": "npm test && node scripts/verify-release.mjs"
  },
  "keywords": [
    "bitcoin",
    "merkle",
    "rfc6962",
    "sha256",
    "opentimestamps",
    "provenance",
    "notary",
    "orphograph"
  ],
  "homepage": "https://orphograph.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/Orphograph/Orphograph"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/node": "^20.11.0"
  }
}
