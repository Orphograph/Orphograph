# Orphograph — environment variables.
# Copy to .env.local for local dev (gitignored). In production, set via
# `fly secrets set KEY=VALUE`. Never commit secrets.

# --- networking ---
HOST=127.0.0.1
PORT=8989
SITE_URL=https://orphograph.com
# Local/dev should leave this at 0. Set to 1 only behind a trusted edge proxy
# such as Fly's http_service, where clients cannot hit the app directly.
ORPHO_TRUST_PROXY_HEADERS=0
# Public health is passive by default. Set to 1 only for private/deep probes.
ORPHO_HEALTH_ACTIVE_PROBES=0

# --- limits ---
RATE_LIMIT_PER_HOUR=10           # free-tier anchors per /24 per hour
MIN_CALENDARS_OK=3                # below this, receipt is flagged "low_redundancy"

# --- Stripe (Pack purchases) ---
# Get this from the Stripe Dashboard → Developers → Webhooks → endpoint signing secret.
# Until set, /api/stripe/webhook returns 503.
STRIPE_WEBHOOK_SECRET=
# Dev-only escape hatch for Stripe URL registration probes before the secret
# exists. Never enable in production.
ORPHO_ALLOW_UNSIGNED_WEBHOOK_PROBE=0
# Number of credits granted per Pack purchase.
PACK_CREDIT_COUNT=10

# --- Email (Resend) ---
# Get this from https://resend.com/api-keys.
# Until set, mailer.py runs in inert mode and logs to stderr.
RESEND_API_KEY=
RESEND_FROM=Orphograph <hello@orphograph.com>
